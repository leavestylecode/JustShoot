# Keep curated reports, provenance, prompts and verification tools in Git.
# Downloads, captured images, generated previews and transient job responses stay local.
*
!*/
!.gitignore
!*.md
!*.py
!*.swift
!*.txt
!LICENSE
!asset.json
!assets.json
!approved-sources.json
!baseline-check.json
!baseline-hashes.json
!master-hashes.json
!inventory.json
!packaging-references.json
!prompt.json
!prompts.json
!jobs.json
!refinements.json
!generated-source.json
!generated-sources.json
!review-notes.json
!validation.json
!*-validation.json
!runtime-validation.json
!final-*.json
!manifest.json
!downloads.json
!audit.json
!imaging-architecture.json
!cover-audit.json
!cover-prompts.json
!offline-scene-metrics.json
!calibration.json
!installed-assets.json
!staged-assets.json
!quality-review.json
!text-review.json
!test-result.json
!bundle-resource-check.json
!ocr-pairs.json
!ocr-results.json

# Source inventories required to reproduce the curated LUT coverage audit.
!lut-coverage-2026-11-04/sources.json
!lut-coverage-2026-11-04/sources/*-inventory.json

# Machine progress and generated response directories are not review evidence.
CURRENT-PROGRESS.md
__pycache__/
**/generated/
**/display-previews/
**/native-watch-results/
**/timed-out-attempts/
**/unapproved-native-sources/
**/deferred/
