    "fuji" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lake beneath the mountain"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山脚的湖泊"
          }
        }
      }
    },
    "fujiC200" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reds and greens stand out in daylight. Slightly warm skin and cool blue shadows give brickwork and nearby shade a clear colour separation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日光下的红色和绿色鲜明，肤色略暖，暗部带一点青蓝。街边的砖墙和树荫放在一起，冷暖层次清楚。"
          }
        }
      }
    },
    "fujiPro400H" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin is luminous, with soft highlights and a cool tint in the shadows. Pale fabric and a face in the same light keep their subtle tonal differences."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肤色明亮，高光过渡柔和，阴影略偏冷。浅色衣料和脸部同时受光时，两者都能保留细腻的明暗层次。"
          }
        }
      }
    },
    "fujiProvia100F" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fujifilm’s standard simulation balances colour and contrast. Skin looks natural, while blue skies and green foliage stay distinct around a subject."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富士的标准模拟，饱和度和反差适中。肤色自然，蓝天和绿叶各自分明，适合在同一画面里交代人物与环境。"
          }
        }
      }
    },
    "fujiRawACROS" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep blacks and gentle highlights frame a finely graded range of greys. Side light brings out the contours of a face and the weave of clothing in a street portrait."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黑位深，高光柔和，中间的灰阶细腻。拍街头人像时，侧光能勾出脸部轮廓，也能带出衣料的纹理。"
          }
        }
      }
    },
    "fujiRawASTIA" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin passes gently from light into shade, while reds and blues in clothing stay vivid. It suits portraits where the clothes matter as much as the face."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肤色从亮面到阴影过渡柔和，衣料的红色和蓝色依然鲜明。适合让人物和服装同时成为画面重点。"
          }
        }
      }
    },
    "fujiRawClassicChrome" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reds and greens are muted, with dense shadows. Street signs recede and the shapes of people and buildings take more of the frame."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "红色和绿色的饱和度较低，阴影较深。街头招牌的颜色变得低调，人物和建筑的轮廓更突出。"
          }
        }
      }
    },
    "fujiRawClassicNeg" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highlights lean warm and shadows take on a green cast. The transition is distinct enough to give the sunlit and shaded halves of a wall different hues."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亮部偏暖，阴影略带青绿，明暗交界清晰。街角同一面墙的向阳处和背阴处，会呈现不同的色调。"
          }
        }
      }
    },
    "fujiRawVelvia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blues and greens are intense, with deep shadows and strong contrast. Warm evening light on a hillside stands out against the slopes in shade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝天和绿叶色彩浓烈，阴影深，明暗反差强。傍晚的暖光落在山坡上时，与背阴处的色差尤其明显。"
          }
        }
      }
    },
    "fujiSlideProvia100F" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This slide-film look has clear colour, moderate saturation and slightly cool highlights. In even daylight, skies retain tonal variation and skin keeps a natural flush."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这款反转片模拟的色彩清晰，饱和度适中，亮部略偏冷。柔和日光下，天空有层次，肤色也能保留自然的红润。"
          }
        }
      }
    },
    "fujiSuperiaXTRA400" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reds are vivid, blues are clear and shadows lean cool. In a street scene, warm skin in the light stands apart from blue-grey areas in shade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "红色鲜明，蓝色清透，暗部略偏冷。用来拍街景，亮处的暖肤色与背阴处的蓝灰色对比清楚。"
          }
        }
      }
    },
    "fujiVelvia50" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This slide-film look gives skies a cool blue and renders red flowers and green foliage in rich colour. Deep shade sets off patches of light across a landscape."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这款反转片模拟让蓝天偏冷，红花和绿叶色彩浓郁。深色阴影衬出受光的色块，适合表现山林和花卉的色彩层次。"
          }
        }
      }
    },
    "haydenSnow" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tree on the snowfield"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雪原上的树"
          }
        }
      }
    },
    "ilfordHP5Plus400" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderate contrast pairs solid shadows with a broad range of mid-greys. In side light, the shaded side of a face remains distinct from dark clothing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黑白反差适中，暗部扎实，中灰层次丰富。室内侧光下，脸部背光一侧的轮廓和深色衣物仍然容易分辨。"
          }
        }
      }
    },
    "kimono" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passing through the lane"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小巷里的行人"
          }
        }
      }
    },
    "kodakEktar100" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High saturation separates blue skies, green foliage and red subjects. Slightly cool highlights set off sunlit brick and warm rock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "饱和度高，蓝天、绿叶和红色物体之间的色差明显。亮部略带冷色，阳光下的红砖和暖色岩石格外醒目。"
          }
        }
      }
    },
    "kodakGold200" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The palette leans warm, with pronounced yellows and oranges and a reddish-brown tint in deep shade. Sunlit skin, dry grass and pale walls take on a golden tone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整体偏暖，黄色和橙色尤其鲜明，暗部带一点红褐色。日光下的肤色、干草和浅色墙面容易呈现金黄色调。"
          }
        }
      }
    },
    "kodakKodachrome64" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reds and earth tones have weight against cool skies and deep shade. Brick, painted cars and sky keep distinct colours in daylight street scenes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "红色和土色沉稳，蓝天略冷，阴影深。日光下的红砖、旧车漆和天空各有清晰的颜色，适合记录旅途中的街景。"
          }
        }
      }
    },
    "kodakPortra400" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin leans warm, with moderate contrast and a gentle transition across the face into shade. Pale clothing gives the warmth of the skin a neutral point of comparison."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肤色偏暖，反差适中，脸部从亮面到阴影过渡柔和。浅色衣服与皮肤同框时，亮部的中性色能衬出肤色的暖意。"
          }
        }
      }
    },
    "kodakPortra800" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin is warm, with soft shadows and slightly cool highlights. Under mixed indoor light, a lamp-lit face keeps its warmth beside cooler window light."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肤色偏暖，暗部柔和，亮部略偏冷。拍室内人物时，暖灯下的脸与窗边较冷的日光仍有清楚的色温差。"
          }
        }
      }
    },
    "kodakTMax100" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smooth gradations from pale to dark grey reveal small differences in tone. Stone, fabric and still-life subjects show their surface texture even in gentle light."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从浅灰到深灰过渡平滑，细微的明暗差也清晰可见。拍石墙、衣料或静物时，表面纹理比大块黑白反差更突出。"
          }
        }
      }
    },
    "kodakTriX400" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bright midtones give lit surfaces clear separation from shade. In a street portrait, light catching a face or a pale shirt draws the subject out of the background."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中间调明亮，亮面和暗面分隔鲜明。拍街头人物时，光照在脸上或浅色衣服上，主体容易从背景中显出来。"
          }
        }
      }
    },
    "lambStreet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
