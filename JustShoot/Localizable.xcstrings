            "value" : "Save the original plus each processing stage (LUT, optics, grain) for every shot. Find them in Files → On My iPhone → %@ → ProcessingDiagnostics. Only the last 6 shots are kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
